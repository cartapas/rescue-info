---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
import { pwaInfo } from 'virtual:pwa-info';

// Metadata de la aplicación
const appVersion = "v0.1.0";
const lastUpdate = "14 Ago 2026";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#0f172a" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen font-sans antialiased flex flex-col justify-between">
    
    <!-- Navbar / Header Base -->
    <header class="bg-slate-800/90 backdrop-blur border-b border-slate-700/80 p-4 sticky top-0 z-50">
      <div class="max-w-2xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-2">
          <span class="text-lg">🇨🇴</span>
          <h1 class="font-bold text-base text-emerald-400 tracking-tight">Cali Ayuda SOS</h1>
        </div>
        <span class="text-[10px] font-mono bg-emerald-950 text-emerald-300 border border-emerald-800/80 px-2 py-0.5 rounded-full">
          Offline Ready
        </span>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-2xl mx-auto p-4 w-full flex-grow">
      <slot />
    </main>

    <!-- Footer Unificado -->
    <footer class="bg-slate-950 border-t border-slate-800/80 mt-12 py-6 px-4 text-slate-400 text-xs">
      <div class="max-w-2xl mx-auto space-y-4">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-800/60 pb-4">
          <div>
            <p class="text-slate-200 font-medium">Iniciativa Ciudadana de Emergencia</p>
            <p class="text-[11px] text-slate-500">Cali, Colombia — Respuesta Sismo 2026</p>
          </div>
          
          <!-- Badges de Versión / Build -->
          <div class="flex items-center gap-2 text-[10px] font-mono">
            <span class="bg-slate-800 text-slate-300 border border-slate-700 px-2 py-0.5 rounded">
              {appVersion}
            </span>
            <span class="text-slate-500">
              Actualizado: {lastUpdate}
            </span>
          </div>
        </div>

        <!-- Créditos y Contacto -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-3 text-[11px] text-slate-400">
          <p>
            Desarrollado con ❤️ para la comunidad de Cali.
          </p>
          
          <div class="flex items-center gap-4">
            <a 
              href="mailto:contacto@caliayuda.co?subject=Sugerencia%20o%20Reporte%20Cali%20Ayuda" 
              class="hover:text-emerald-400 transition-colors underline underline-offset-2"
            >
              ✉️ Reportar un error / Contacto
            </a>
            <a 
              href="https://github.com/TU_USUARIO/TU_REPO" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-slate-200 transition-colors"
            >
              💻 Código Fuente
            </a>
          </div>
        </div>

      </div>
    </footer>

    <script src="/src/pwa.ts"></script>
  </body>
</html>