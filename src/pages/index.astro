---
import Layout from '../layouts/Layout.astro';
import RecursoCard from '../components/RecursoCard.astro';
import { getCategoryIcon } from '../utils/getCategoryIcon';

// Obtener las variables del archivo .env
const BASE_API_URL = import.meta.env.PUBLIC_APPS_SCRIPT_URL;
const SECRET_TOKEN = import.meta.env.PUBLIC_SECRET_TOKEN;

// Construir la URL agregando el parámetro ?token= de forma segura
let API_URL = "";
if (BASE_API_URL) {
  try {
    const urlObj = new URL(BASE_API_URL);
    if (!urlObj.searchParams.has('token') && SECRET_TOKEN) {
      urlObj.searchParams.append('token', SECRET_TOKEN);
    }
    API_URL = urlObj.toString();
  } catch {
    API_URL = BASE_API_URL;
  }
}

let recursos = [];
let categoriasMapa: Record<string, any[]> = {};

if (API_URL) {
  try {
    const res = await fetch(API_URL);
    if (res.ok) {
      const data = await res.json();
      
      // Verificación defensiva: solo ejecutamos .forEach si data es un Arreglo (Array)
      if (Array.isArray(data)) {
        recursos = data;

        recursos.forEach((item) => {
          const cat = item.categoria || 'General';
          if (!categoriasMapa[cat]) {
            categoriasMapa[cat] = [];
          }
          categoriasMapa[cat].push(item);
        });
      } else {
        console.error("La API no devolvió un arreglo. Respuesta recibida:", data);
      }
    }
  } catch (error) {
    console.error("Error al consultar Google Sheets API:", error);
  }
} 

const listaCategorias = Object.keys(categoriasMapa);
---

<Layout title="Cali Ayuda - Directorio por Categorías">
  <div class="space-y-4 py-2">
    <!-- Header Principal Compacto -->
    <div class="text-center space-y-1 border-b border-slate-800 pb-3">
      <span class="text-[10px] font-semibold uppercase tracking-wider bg-emerald-900/60 text-emerald-300 px-2.5 py-0.5 rounded-full border border-emerald-700/50">
        Directorio Central
      </span>
      <h1 class="text-xl font-bold text-white">Cali Ayuda App: Recursos para apoyar</h1>
      <p class="text-xs text-slate-400 max-w-md mx-auto">
        Filtramos y consolidados la información útil que llega a través de múltiples canales comunitarios durante la coyuntura actual, facilitando la búsqueda por temas de interés.
      </p>
    </div>

    {listaCategorias.length > 0 ? (
      <div id="directorio-app" class="space-y-4">
        
        <!-- Bar de Controles: Filtro de Estado -->
        <div class="flex justify-between items-center bg-slate-800/60 border border-slate-700/60 px-3 py-2 rounded-xl text-xs">
          <span class="text-slate-300 font-medium text-[11px] flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Mostrando puntos <strong class="text-emerald-400">ACTIVOS</strong>
          </span>

          <label class="flex items-center gap-2 cursor-pointer select-none text-[11px] text-slate-400 hover:text-slate-200 transition-colors">
            <input 
              type="checkbox" 
              id="toggle-inactivos" 
              class="rounded bg-slate-900 border-slate-700 text-emerald-500 focus:ring-0 focus:ring-offset-0 cursor-pointer"
            />
            <span>Mostrar inactivos y fraudes</span>
          </label>
        </div>

        <!-- Pestañas de Categorías: 4 fijas por fila con tipografía optimizada para móvil -->
        <div class="grid grid-cols-4 gap-1.5 pb-2">
          {listaCategorias.map((cat, index) => {
            const icon = getCategoryIcon(cat);
            return (
              <button
                data-category-tab={cat}
                class={`tab-btn flex flex-col sm:flex-row items-center justify-center gap-1 text-[10px] sm:text-xs font-semibold px-1 py-1.5 sm:px-2 sm:py-2 rounded-lg border text-center transition-all ${
                  index === 0
                    ? "bg-emerald-700 text-white border-emerald-600 shadow-sm"
                    : "bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700"
                }`}
              >
                <span class="text-xs sm:text-sm leading-none">{icon}</span>
                <span class="truncate max-w-full leading-tight">{cat}</span>
                <span class="text-[9px] sm:text-[10px] opacity-75 bg-slate-900/50 px-1 py-0.2 sm:px-1.5 sm:py-0.5 rounded-full font-mono">
                  {categoriasMapa[cat].length}
                </span>
              </button>
            );
          })}
        </div>

        <!-- Paneles de Contenido de Categorías -->
        {listaCategorias.map((cat, index) => {
          const items = categoriasMapa[cat];
          const icon = getCategoryIcon(cat);

          return (
            <div
              data-category-panel={cat}
              class={`category-panel space-y-3 ${index === 0 ? "" : "hidden"}`}
              data-current-page="1"
            >
              <!-- Encabezado de la Categoría Seleccionada -->
              <div class="flex items-center gap-2 border-b border-slate-800 pb-2 mb-2">
                <span class="text-xl">{icon}</span>
                <h2 class="text-sm font-bold text-white">{cat}</h2>
              </div>

              <!-- Listado de Tarjetas -->
              <div class="cards-container space-y-3">
                {items.map((item) => {
                  const esActivo = (item.estado || 'ACTIVO') === 'ACTIVO';
                  return (
                    <div 
                      class="item-card transition-all"
                      data-estado={item.estado || 'ACTIVO'}
                      data-es-activo={esActivo ? "true" : "false"}
                    >
                      <RecursoCard recurso={item} />
                    </div>
                  );
                })}
              </div>

              <!-- Mensaje cuando no hay elementos activos en la categoría -->
              <div class="empty-category-msg hidden text-center py-8 text-slate-500 text-xs bg-slate-800/20 rounded-xl border border-slate-800/80">
                No hay recursos activos en esta categoría en este momento.
              </div>

              <!-- Control de Paginación de 5 en 5 -->
              <div class="pagination-bar flex justify-between items-center bg-slate-800/80 border border-slate-700/80 rounded-lg p-2 mt-3 text-xs">
                <button
                  data-page-action="prev"
                  class="prev-btn bg-slate-700 hover:bg-slate-600 disabled:opacity-40 text-white px-3 py-1 rounded font-medium transition-colors"
                  disabled
                >
                  ← Anterior
                </button>
                <span class="page-info text-slate-400 font-mono text-[11px]">
                  Página <strong class="text-white current-page">1</strong> de <strong class="text-white total-pages">1</strong>
                </span>
                <button
                  data-page-action="next"
                  class="next-btn bg-slate-700 hover:bg-slate-600 disabled:opacity-40 text-white px-3 py-1 rounded font-medium transition-colors"
                >
                  Siguiente →
                </button>
              </div>
            </div>
          );
        })}

      </div>
    ) : (
      <div class="text-center py-12 text-slate-500 text-sm bg-slate-800/30 rounded-xl border border-slate-800">
        No hay reportes cargados actualmente o la base de datos se está actualizando...
      </div>
    )}
  </div>
</Layout>

<script>
  // Lógica cliente para tabs, filtrado de estados y paginación
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.category-panel');
    const toggleInactivos = document.getElementById('toggle-inactivos') as HTMLInputElement;

    const ITEMS_PER_PAGE = 5;

    // Recalcula visibilidad y paginación para un panel específico
    const renderPanelPagination = (panel: Element) => {
      const showInactivos = toggleInactivos ? toggleInactivos.checked : false;
      const cards = Array.from(panel.querySelectorAll('.item-card')) as HTMLElement[];
      const emptyMsg = panel.querySelector('.empty-category-msg');
      const paginationBar = panel.querySelector('.pagination-bar') as HTMLElement;
      const currentPageEl = panel.querySelector('.current-page');
      const totalPagesEl = panel.querySelector('.total-pages');
      const prevBtn = panel.querySelector('.prev-btn') as HTMLButtonElement;
      const nextBtn = panel.querySelector('.next-btn') as HTMLButtonElement;

      // 1. Filtrar las tarjetas a mostrar
      const visibleCards = cards.filter((card) => {
        const esActivo = card.getAttribute('data-es-activo') === 'true';
        return showInactivos ? true : esActivo;
      });

      // Ocultar todas las tarjetas inicialmente
      cards.forEach((c) => c.classList.add('hidden'));

      // Manejar caso de categoría vacía
      if (visibleCards.length === 0) {
        if (emptyMsg) emptyMsg.classList.remove('hidden');
        if (paginationBar) paginationBar.classList.add('hidden');
        return;
      } else {
        if (emptyMsg) emptyMsg.classList.add('hidden');
        if (paginationBar) paginationBar.classList.remove('hidden');
      }

      // 2. Calcular páginas dinámicamente
      const totalPages = Math.ceil(visibleCards.length / ITEMS_PER_PAGE) || 1;
      let currentPage = parseInt(panel.getAttribute('data-current-page') || '1', 10);
      if (currentPage > totalPages) currentPage = totalPages;
      panel.setAttribute('data-current-page', String(currentPage));

      // 3. Renderizar sólo la porción de 5 ítems correspondiente a la página actual
      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      const pageCards = visibleCards.slice(startIndex, endIndex);

      pageCards.forEach((card) => card.classList.remove('hidden'));

      // 4. Actualizar estado de los controles de UI
      if (currentPageEl) currentPageEl.textContent = String(currentPage);
      if (totalPagesEl) totalPagesEl.textContent = String(totalPages);
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages || totalPages === 0;
    };

    const updateAllPanels = () => {
      panels.forEach((p) => renderPanelPagination(p));
    };

    // Escuchar el conmutador "Mostrar inactivos y fraudes"
    toggleInactivos?.addEventListener('change', () => {
      panels.forEach((p) => p.setAttribute('data-current-page', '1'));
      updateAllPanels();
    });

    // Pestañas (Tabs)
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-category-tab');

        tabBtns.forEach((b) => {
          b.classList.remove('bg-emerald-700', 'text-white', 'border-emerald-600');
          b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
        });
        btn.classList.add('bg-emerald-700', 'text-white', 'border-emerald-600');
        btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');

        panels.forEach((p) => {
          if (p.getAttribute('data-category-panel') === targetCategory) {
            p.classList.remove('hidden');
            renderPanelPagination(p);
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // Botones de Paginación
    panels.forEach((panel) => {
      const prevBtn = panel.querySelector('.prev-btn');
      const nextBtn = panel.querySelector('.next-btn');

      prevBtn?.addEventListener('click', () => {
        let currentPage = parseInt(panel.getAttribute('data-current-page') || '1', 10);
        if (currentPage > 1) {
          panel.setAttribute('data-current-page', String(currentPage - 1));
          renderPanelPagination(panel);
        }
      });

      nextBtn?.addEventListener('click', () => {
        let currentPage = parseInt(panel.getAttribute('data-current-page') || '1', 10);
        panel.setAttribute('data-current-page', String(currentPage + 1));
        renderPanelPagination(panel);
      });
    });

    // Ejecución inicial
    updateAllPanels();
  });
</script>