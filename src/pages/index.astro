---
import Layout from '../layouts/Layout.astro';

const categorias = [
  {
    titulo: "🚨 Personas Desaparecidas",
    descripcion: "Bases de datos oficiales y líneas de búsqueda para reagrupación familiar.",
    color: "border-red-500/40 bg-red-950/20",
    enlaces: [
      { nombre: "Colombia Te Busca (Registro Web)", url: "https://colombiatebusca.com", destacado: true },
      { nombre: "Cruz Roja - WhatsApp Búsqueda", url: "https://wa.me/573212139525", subtexto: "+57 321 213 9525" },
      { nombre: "Línea Nacional Cruz Roja (132)", url: "tel:132" }
    ]
  },
  {
    titulo: "❤️ Donaciones y Sangre",
    descripcion: "Canales autorizados para aportes monetarios y donación de sangre en Cali.",
    color: "border-emerald-500/40 bg-emerald-950/20",
    enlaces: [
      { nombre: "Portal de Donación Unificado", url: "https://www.onepay.la/donar", destacado: true },
      { nombre: "Banco Regional de Sangre (San Fernando)", url: "https://maps.google.com/?q=Carrera+38+Bis+%23+5-91+Cali", subtexto: "Cra. 38 Bis # 5-91" }
    ]
  },
  {
    titulo: "🏡 Albergues y Centros de Acopio",
    descripcion: "Puntos de recepción de ayuda humanitaria e información municipal.",
    color: "border-amber-500/40 bg-amber-950/20",
    enlaces: [
      { nombre: "Alcaldía de Cali (Información Oficial)", url: "https://www.cali.gov.co", destacado: true },
      { nombre: "Coliseo Miguel Calero (Panamericanas)", url: "https://maps.google.com/?q=Coliseo+Miguel+Calero+Cali" }
    ]
  },
  {
    titulo: "🐾 Mascotas Extraviadas y Veterinaria",
    descripcion: "Redes de apoyo, albergues temporales de paso y clínicas aliadas.",
    color: "border-purple-500/40 bg-purple-950/20",
    enlaces: [
      { nombre: "Reportar / Buscar Mascota", url: "#" },
      { nombre: "Red de Urgencias Veterinarias (Royi Pets)", url: "#" }
    ]
  },
  {
    titulo: "🧠 Apoyo Psicológico y Salud Mental",
    descripcion: "Líneas de atención en crisis y contención emocional gratuita.",
    color: "border-blue-500/40 bg-blue-950/20",
    enlaces: [
      { nombre: "Línea 106 (Atención Psicológica Cali)", url: "tel:106", destacado: true },
      { nombre: "Línea de Red de Apoyo Emocional", url: "tel:123" }
    ]
  },
  {
    titulo: "🏗️ Revisión de Estructuras e Ingeniería",
    descripcion: "Solicitud de inspección técnica para viviendas e infraestructura dañada.",
    color: "border-slate-500/40 bg-slate-800/40",
    enlaces: [
      { nombre: "Reportar Daño Estructural a Gestión del Riesgo", url: "tel:119" },
      { nombre: "Red Voluntaria de Arquitectos / Ingenieros", url: "#" }
    ]
  }
];
---

<Layout title="Red de Respuesta y Emergencia - Cali">
  <div class="space-y-6 py-2">
    <!-- Header de Contexto -->
    <div class="text-center space-y-2 border-b border-slate-800 pb-4">
      <span class="text-xs font-semibold uppercase tracking-wider bg-emerald-900/60 text-emerald-300 px-3 py-1 rounded-full border border-emerald-700/50">
        Directorio Unificado de Emergencia
      </span>
      <h1 class="text-2xl font-bold text-white">Asistencia y Recursos SOS Cali</h1>
      <p class="text-xs text-slate-400 max-w-lg mx-auto">
        Acceso centralizado a enlaces oficiales, líneas de atención, albergues y apoyo para la comunidad tras el sismo.
      </p>
    </div>

    <!-- Grid de Categorías -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {categorias.map((cat) => (
        <div class={`border rounded-xl p-4 shadow-sm transition-all ${cat.color}`}>
          <h2 class="text-lg font-bold text-white mb-1">{cat.titulo}</h2>
          <p class="text-xs text-slate-300 mb-4">{cat.descripcion}</p>
          
          <div class="space-y-2">
            {cat.enlaces.map((link) => (
              <a
                href={link.url}
                target={link.url.startsWith('http') ? "_blank" : "_self"}
                rel="noopener noreferrer"
                class={`flex items-center justify-between p-2.5 rounded-lg text-xs font-medium transition-colors ${
                  link.destacado 
                    ? "bg-slate-100 text-slate-900 hover:bg-white font-semibold" 
                    : "bg-slate-800/80 text-slate-200 hover:bg-slate-700 border border-slate-700/60"
                }`}
              >
                <span>{link.nombre}</span>
                {link.subtexto && <span class="text-[10px] opacity-75">{link.subtexto}</span>}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Teléfonos Rápidos de Emergencia -->
    <div class="bg-slate-800/90 border border-slate-700 rounded-xl p-4 text-center mt-6">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Líneas de Emergencia Directas</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="tel:123" class="bg-red-900/80 hover:bg-red-800 text-red-100 text-xs px-3 py-1.5 rounded-lg border border-red-700">🚑 Emergencias: 123</a>
        <a href="tel:119" class="bg-amber-900/80 hover:bg-amber-800 text-amber-100 text-xs px-3 py-1.5 rounded-lg border border-amber-700">🚒 Bomberos: 119</a>
        <a href="tel:144" class="bg-blue-900/80 hover:bg-blue-800 text-blue-100 text-xs px-3 py-1.5 rounded-lg border border-blue-700">🛡️ Defensa Civil: 144</a>
      </div>
    </div>
  </div>
</Layout>