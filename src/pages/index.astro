---
import Layout from '../layouts/Layout.astro';
import RecursoCard from '../components/RecursoCard.astro';

// Reemplaza con la URL copiada de Apps Script en el Paso 2
const API_URL = "https://script.google.com/macros/s/AKfycbwXXQmr_aaO8TXIl4sPDkhF4NS4s1DgptPbzm6gQwdA53uvQTC2BxQEKm53DJpHk72q/exec";

let recursos = [];

try {
  const res = await fetch(API_URL);
  if (res.ok) {
    recursos = await res.json();
  }
} catch (error) {
  console.error("Error al consultar Google Sheets API:", error);
}
---

<Layout title="Cali Ayuda - Directorio Comunitario de Emergencia">
  <div class="space-y-6 py-2">
    <div class="text-center space-y-2 border-b border-slate-800 pb-4">
      <span class="text-xs font-semibold uppercase tracking-wider bg-emerald-900/60 text-emerald-300 px-3 py-1 rounded-full border border-emerald-700/50">
        Directorio Verificado
      </span>
      <h1 class="text-2xl font-bold text-white">Cali Ayuda: Puntos y Reportes</h1>
      <p class="text-xs text-slate-400 max-w-lg mx-auto">
        Información centralizada de donaciones, albergues y reportes tras el sismo. Verifica los datos del contacto antes de realizar aportes.
      </p>
    </div>

    <!-- Lista de Entradas -->
    <div class="space-y-4">
      {recursos.length > 0 ? (
        recursos.map((item) => <RecursoCard recurso={item} />)
      ) : (
        <div class="text-center py-12 text-slate-500 text-sm">
          No hay reportes cargados o el servicio se está actualizando...
        </div>
      )}
    </div>
  </div>
</Layout>